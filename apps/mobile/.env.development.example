# Copy this file to .env.development and fill in real values.
# .env.development is gitignored — never commit real credentials.

APP_ENV=development

# Convex deployment URL — from `npx convex dev` in packages/backend
CONVEX_URL=https://your-dev-deployment.convex.cloud

# EAS project ID — from https://expo.dev after running `eas init`
EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
