{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "APP_ENV=development expo start",
    "dev:staging": "APP_ENV=staging expo start",
    "run:ios": "EXPO_NO_CAPABILITY_SYNC=1 expo run:ios",
    "run:android": "expo run:android",
    "reset:ios": "rm -rf ios && EXPO_NO_CAPABILITY_SYNC=1 expo run:ios",
    "reset:android": "rm -rf android && expo run:android",
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "generate:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.91",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "convex": "^1.34.1",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.11",
    "expo-dev-client": "~55.0.0",
    "expo-localization": "~55.0.0",
    "expo-notifications": "~55.0.0",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "i18next": "^26.0.3",
    "react": "19.2.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.23.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@types/sharp": "^0.32.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "react-test-renderer": "19.2.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3"
  }
}
