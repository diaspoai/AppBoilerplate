# Use hoisted node_modules layout.
# Required for React Native tooling (Metro, Jest) which expects packages
# to be resolvable from a flat node_modules tree rather than pnpm's
# default symlink/virtual-store structure.
node-linker=hoisted

# Hoist ALL packages to the root node_modules.
# Required for React Native 0.79+ codegen scripts (generate-codegen-artifacts.js)
# which traverse the full dependency tree and expect every package to be
# reachable from the monorepo root — not just direct dependencies.
shamefully-hoist=true
