# Copy this file to .env.development, .env.staging, and .env.production
# and fill in the values for each environment.
# These files are gitignored — never commit real values.

# Convex deployment URL
# Get this from your Convex dashboard after running `npx convex dev`
CONVEX_URL=https://your-deployment.convex.cloud

# EAS project ID
# Get this from https://expo.dev after running `eas init`
EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
